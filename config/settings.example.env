# Copy to .env and fill in. NEVER commit .env.

# --- LLM (provider-agnostic: any OpenAI-compatible endpoint) ---
# OpenRouter example:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Strategy/model routing: strong model for planning, cheap model for bulk
# Comma-separated = failover chain (hops on upstream 429 saturation or a
# retired/renamed model slug -- OpenRouter's free/preview slugs churn; verify
# your chain still resolves with a live curl before demoing, not just at
# whatever date this file was written)
LLM_MODEL_STRATEGY=nvidia/nemotron-3-super-120b-a12b:free, z-ai/glm-5.3-flash, z-ai/glm-5.2:free
LLM_MODEL_BULK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free, z-ai/glm-5.3-flash, z-ai/glm-5.2:free
# Reasoning budget for reasoning models: max | high | medium | low | minimal
LLM_REASONING_EFFORT=max

# --- Arena ---
ARENA_TXN_PER_CAMPAIGN_DEFAULT=2000
ARENA_MAX_CONCURRENT_CAMPAIGNS=500
LEDGER_DB_URL=sqlite:///arena_ledger.db

# --- Paths ---
DATA_RAW_DIR=data/raw
DATA_SPLITS_DIR=data/splits
